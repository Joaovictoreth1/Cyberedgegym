# Configurações de ambiente — CyberEdge Gym Backend
# Copie este arquivo para .env e preencha os valores reais

# Banco de dados (padrão: SQLite local)
DATABASE_URL=cyberedge.db

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://joaovictoreth1.github.io

# Chave secreta para JWT (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=SUBSTITUA_AQUI_POR_UMA_CHAVE_SEGURA

# Configurações de email (opcional — para notificações de novos leads)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_de_app
# EMAIL_DESTINO=contato@cyberedgegym.com.br

# Ambiente (development | production)
ENVIRONMENT=development
