# Copie para backend/.env apenas para desenvolvimento local.
ENVIRONMENT=development
DATABASE_URL=cyberedge.db

# Origens completas sem barra final, separadas por vírgula. Produção aceita apenas HTTPS.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Obrigatório em produção; sem token, as rotas administrativas ficam desativadas.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=
CONTACT_RATE_LIMIT=10
CONTACT_RATE_WINDOW_SECONDS=60
CONTACT_RATE_MAX_CLIENTS=10000
MAX_REQUEST_BYTES=4096
